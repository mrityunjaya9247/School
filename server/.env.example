# Copy this file to .env and adjust. .env is gitignored — never commit it.

# ---------------------------------------------------------------------
# PostgreSQL (Amazon RDS)
# DB_HOST is the RDS endpoint from the AWS console — no https://, no port
# suffix. DB_NAME defaults to `postgres` if you left "Initial database
# name" blank at instance creation.
# ---------------------------------------------------------------------
DB_HOST=your-instance.xxxxxxxx.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_master_password_here
DB_SCHEMA=school

# true = encrypted (keep this for RDS). false = plain, local Postgres only.
DB_SSL=true
# Optional: verify the server cert too. Download the bundle first:
#   curl -o certs/rds-ca.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# DB_SSL_CA=certs/rds-ca.pem

DB_POOL_MAX=10

# Master switch for the whole feature. The frontend also has its own local
# AI_CONFIG.enabled flag (in index.html) so the button can be hidden without
# even calling this server, but this is the flag that actually governs the API.
AI_REWRITE_ENABLED=true

# Option 1: Local Ollama (default)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:4b
# LLM_API_KEY=

# Option 2: AskCodi API (https://api.askcodi.com/v1)
LLM_BASE_URL=https://api.askcodi.com/v1
LLM_MODEL=claude-4.5-sonnet
LLM_API_KEY=your_askcodi_api_key_here

# Option 3: Official OpenAI API
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your_openai_api_key_here

# Which port this proxy listens on, and which origin(s) may call it (the
# static frontend's origin — e.g. http://localhost:8000 for the dev server,
# or your deployed site's origin). Comma-separate multiple origins.
PORT=8787
ALLOWED_ORIGINS=http://localhost:8000
