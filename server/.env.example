# Copy this file to .env and adjust. .env is gitignored — never commit it.

# Master switch for the whole feature. The frontend also has its own local
# AI_CONFIG.enabled flag (in index.html) so the button can be hidden without
# even calling this server, but this is the flag that actually governs the API.
AI_REWRITE_ENABLED=true

# Where the OpenAI-compatible LLM lives. Default assumes Ollama running on the
# same machine as this server.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b

# Optional. Only sent as "Authorization: Bearer <key>" when set — local Ollama
# needs no key at all, so leave this blank unless your LLM_BASE_URL requires one.
LLM_API_KEY=

# Which port this proxy listens on, and which origin(s) may call it (the
# static frontend's origin — e.g. http://localhost:8000 for the dev server,
# or your deployed site's origin). Comma-separate multiple origins.
PORT=8787
ALLOWED_ORIGINS=http://localhost:8000
